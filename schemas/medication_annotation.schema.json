{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ken1301/NCKH_Mediacare-/schema/medication_annotation.schema.json",
  "title": "MediCare Medication Annotation",
  "description": "Annotation contract cho medication NER và relation extraction; partial annotation được phép nhưng phải ghi trạng thái.",
  "type": "object",
  "required": ["schema_version", "sample_id", "entities", "relations", "annotation_status"],
  "properties": {
    "schema_version": { "const": "medication.annotation.v1" },
    "sample_id": { "type": "string", "minLength": 1 },
    "image": {
      "type": "object",
      "properties": {
        "file_name": { "type": ["string", "null"] },
        "width": { "type": ["integer", "null"], "minimum": 1 },
        "height": { "type": ["integer", "null"], "minimum": 1 }
      },
      "additionalProperties": false
    },
    "entities": {
      "type": "array",
      "items": { "$ref": "#/$defs/entity" }
    },
    "relations": {
      "type": "array",
      "items": { "$ref": "#/$defs/relation" }
    },
    "annotation_status": {
      "type": "string",
      "enum": ["partial", "complete", "needs_review"]
    },
    "privacy": {
      "type": "object",
      "properties": {
        "de_identified": { "type": "boolean" },
        "reviewed": { "type": "boolean" },
        "approved_for_research": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "review": {
      "type": "object",
      "properties": {
        "annotator_id": { "type": ["string", "null"] },
        "reviewer_id": { "type": ["string", "null"] },
        "notes": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "entity": {
      "type": "object",
      "required": ["id", "label", "text", "bbox"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "label": {
          "type": "string",
          "enum": ["DRUG", "STRENGTH", "DOSE", "FORM", "ROUTE", "FREQUENCY", "DURATION", "TIMING", "INSTRUCTION"]
        },
        "text": { "type": "string", "minLength": 1 },
        "normalized_text": { "type": ["string", "null"] },
        "bbox": {
          "type": "array",
          "prefixItems": [
            { "type": "number" },
            { "type": "number" },
            { "type": "number" },
            { "type": "number" }
          ],
          "minItems": 4,
          "maxItems": 4
        },
        "confidence": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "needs_review": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "relation": {
      "type": "object",
      "required": ["id", "type", "source_entity_id", "target_entity_id"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "type": {
          "type": "string",
          "enum": ["HAS_STRENGTH", "HAS_DOSE", "HAS_FORM", "HAS_ROUTE", "HAS_FREQUENCY", "HAS_DURATION", "HAS_TIMING", "HAS_INSTRUCTION"]
        },
        "source_entity_id": { "type": "string", "minLength": 1 },
        "target_entity_id": { "type": "string", "minLength": 1 },
        "confidence": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "needs_review": { "type": "boolean" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
