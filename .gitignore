# Local and unverified external datasets — never commit raw medical images.
dataset/external/**
!dataset/external/README.md
dataset/metadata/vaipe-p-inspection/**
dataset/metadata/vaipe-p-baseline/**
runtime/**
dataset/working/**
dataset/annotations/**
!dataset/annotations/
!dataset/annotations/incoming/
!dataset/annotations/incoming/**/
!dataset/annotations/incoming/**/*.json
!dataset/annotations/gold/
!dataset/annotations/gold/**/*.json
!dataset/annotations/merge-report.json
*.zip
*.7z
*.rar
*.jpg
*.jpeg
*.png
*.webp
*.tif
*.tiff

# Training checkpoints are large and are not required for inference.
# Keep the exported inference model and evaluation/text artifacts tracked.
dataset/processed/**/fine-tune/model/*.pdparams
dataset/processed/**/fine-tune/model/*.pdopt
dataset/processed/**/fine-tune/model/*.states
dataset/processed/**/fine-tune/**/*.pdparams
dataset/processed/**/fine-tune/**/*.pdopt
dataset/processed/**/fine-tune/**/*.states
